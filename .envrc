# direnv configuration for G1 Perception ROS2 Workspace

# 1. Ensure system bin is prioritized (avoids conda python3.13 shadowing ROS2 Jazzy python3.12)
PATH_add /usr/bin
PATH_add /bin

# 2. Source ROS2 Jazzy environment
if [ -f /opt/ros/jazzy/setup.bash ]; then
    source_env /opt/ros/jazzy/setup.bash
fi

# 3. G1 Network & CycloneDDS settings
export CYCLONEDDS_HOME="/home/thakk100/cyclonedds/install"
export G1_INTERFACE="${G1_INTERFACE:-enp2s0}"

# 4. Activate Python virtual environment (.venv)
if [ -d .venv ]; then
    source_env .venv/bin/activate
    if [ -d .venv/lib/python3.12/site-packages ]; then
        export PYTHONPATH="$(pwd)/.venv/lib/python3.12/site-packages${PYTHONPATH:+:$PYTHONPATH}"
    fi
fi

# 5. Source local workspace install overlay if built
if [ -f install/setup.bash ]; then
    source_env install/setup.bash
fi
