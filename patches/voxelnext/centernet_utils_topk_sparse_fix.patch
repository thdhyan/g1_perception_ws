+                    torch.full((_pad,), _pad_i, dtype=topk_ind.dtype,
+                               device=topk_ind.device)
+                ])
+                _pad_classes = torch.zeros(_pad, dtype=_topk_classes.dtype,
+                                           device=_topk_classes.device)
+                _topk_classes = torch.cat([_topk_classes, _pad_classes])
 
