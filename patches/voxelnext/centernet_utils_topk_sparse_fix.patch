@@ -261,8 +261,36 @@ def _topk_1d(scores, batch_size, batch_idx, obj, K=40, nuscenes=False):
             topk_scores, topk_inds = torch.topk(score, min(K, score.shape[-1]))
             topk_score, topk_ind = torch.topk(topk_scores.view(-1), min(K, topk_scores.view(-1).shape[-1]))
             #topk_score, topk_ind = torch.topk(score.reshape(-1), K)
+            # ── (a) class ids from the REAL (unpadded) flat indices ──────────
+            # flat layout of topk_scores is (C, k): class = flat_idx // k,
+            # where k = min(K, N_vox) candidates per class.
+            _block = topk_scores.shape[-1]
+            _topk_classes = (topk_ind // _block).int()
+            # ── (b) sparse-frame fix: pad to K if fewer than K candidates ────
