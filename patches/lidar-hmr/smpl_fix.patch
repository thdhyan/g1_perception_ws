+except ImportError:
+    def _safe_zero_division(numerator, denominator):
+        eps = 1e-8 * denominator.new_ones(1)
+        return numerator / torch.clamp(denominator, min=eps.item())
+
+    def matrix_to_axis_angle(matrix):
+        """Convert rotation matrices to axis-angle (via quaternion). Pure-torch fallback."""
+        batch_dim = matrix.shape[:-2]
+        m00, m01, m02 = matrix[..., 0, 0], matrix[..., 0, 1], matrix[..., 0, 2]
+        m10, m11, m12 = matrix[..., 1, 0], matrix[..., 1, 1], matrix[..., 1, 2]
+        m20, m21, m22 = matrix[..., 2, 0], matrix[..., 2, 1], matrix[..., 2, 2]
+        trace = m00 + m11 + m22
+        qw = torch.sqrt(torch.clamp(1 + trace, min=1e-8)) / 2
+        qx = _safe_zero_division(m21 - m12, 4 * qw)
+        qy = _safe_zero_division(m02 - m20, 4 * qw)
+        qz = _safe_zero_division(m10 - m01, 4 * qw)
+        quat = torch.stack([qw, qx, qy, qz], dim=-1)
+        norms = torch.norm(quat[..., 1:], p=2, dim=-1, keepdim=True)
+        half_angles = torch.atan2(norms, quat[..., :1])
+        angles = 2 * half_angles
+        axis = _safe_zero_division(quat[..., 1:], norms)
+        return axis * angles
 
