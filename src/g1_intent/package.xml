<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>g1_intent</name>
  <version>0.1.0</version>
  <description>
    ROS2 wrapper around intent-sim: LLM plan on the live PhaseSpace scene, intent-sim style
    review GUI, and a PhaseSpace closed-loop goto executor driving LocoClient via robot_bridge.
  </description>
  <maintainer email="th.dhyan.us@gmail.com">thakk100</maintainer>
  <license>MIT</license>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>g1_mocap_labeler</exec_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
