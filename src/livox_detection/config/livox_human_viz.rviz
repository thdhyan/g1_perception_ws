Panels:
  - Class: rviz_common/Displays
    Help Height: 78
    Name: Displays
    Property Tree Widget:
      Expanded:
        - /Global Options1
        - /TF1
        - /RobotModel1
        - /Livox LiDAR PointCloud1
        - /Human Detection Boxes1
        - /Sorted Human Badges1
        - /Selected Human Target1
        - /Loco Approach Trajectory1
      Splitter Ratio: 0.5
    Tree Height: 600
Visualization Manager:
  Class: ""
  Displays:
    - Alpha: 0.5
      Cell Size: 1
      Class: rviz_default_plugins/Grid
      Color: 160; 160; 164
      Enabled: true
      Line Style:
        Line Width: 0.03
        Value: Lines
      Name: Grid
      Normal Cell Count: 0
      Offset:
        X: 0
        Y: 0
        Z: 0
      Plane: XY
      Plane Cell Count: 20
      Reference Frame: pelvis
      Value: true
    - Class: rviz_default_plugins/TF
      Enabled: true
      Frame Timeout: 15
      Frames:
        All Enabled: true
      Marker Scale: 0.3
      Name: TF
      Show Arrows: true
      Show Axes: true
      Show Names: true
      Tree:
        {}
      Update Interval: 0
      Value: true
    - Alpha: 1
      Class: rviz_default_plugins/RobotModel
      Collision Enabled: false
      Description File: ""
      Description Source: Topic
      Description Topic:
        Depth: 5
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /robot_description
      Enabled: true
      Name: RobotModel
      Visual Enabled: true
    - Alpha: 0.85
      Autocompute Intensity Bounds: true
      Autocompute Value Bounds:
        Max Value: 10
        Min Value: -10
        Value: true
      Axis: Z
      Channel Name: intensity
      Class: rviz_default_plugins/PointCloud2
      Color: 255; 255; 255
      Color Transformer: FlatColor
      Decay Time: 0
      Depth: 5
      Durability Policy: Volatile
      Enabled: true
      History Policy: Keep Last
      Max Color: 255; 255; 255
      Max Intensity: 4096
      Min Color: 0; 0; 0
      Min Intensity: 0
      Name: Livox LiDAR PointCloud
      Position Transformer: XYZ
      Reliability Policy: Best Effort
      Selectable: true
      Size (Pixels): 3
      Size (m): 0.025
      Style: Flat Squares
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Best Effort
        Value: /livox/lidar
      Use Fixed Frame: true
      Use rainbow: true
      Value: true
    - Class: rviz_default_plugins/MarkerArray
      Depth: 5
      Durability Policy: Volatile
      Enabled: true
      History Policy: Keep Last
      Name: Human Detection Boxes
      Namespaces:
        livox_3d_boxes: true
        livox_labels: true
      Reliability Policy: Reliable
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /g1/detection_markers/livox
      Value: true
    - Class: rviz_default_plugins/MarkerArray
      Depth: 5
      Durability Policy: Volatile
      Enabled: true
      History Policy: Keep Last
      Name: Sorted Human Badges
      Namespaces:
        human_footprints: true
        human_rank_tags: true
      Reliability Policy: Reliable
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /g1/sorted_human_markers
      Value: true
    - Class: rviz_default_plugins/MarkerArray
      Depth: 5
      Durability Policy: Volatile
      Enabled: true
      History Policy: Keep Last
      Name: Selected Human Target
      Namespaces:
        selected_human_beacon: true
      Reliability Policy: Reliable
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /g1/selected_human_marker
      Value: true
    - Class: rviz_default_plugins/MarkerArray
      Depth: 5
      Durability Policy: Volatile
      Enabled: true
      History Policy: Keep Last
      Name: Loco Approach Trajectory
      Namespaces:
        approach_path: true
        standoff_gap: true
        stopping_label: true
        stopping_pad: true
      Reliability Policy: Reliable
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /g1/approach_markers
      Value: true
  Enabled: true
  Global Options:
    Background Color: 20; 22; 28
    Fixed Frame: pelvis
    Frame Rate: 30
  Name: root
  Tools:
    - Class: rviz_default_plugins/Interact
      Hide Inactive Objects: true
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
  Transformation:
    Current:
      Class: rviz_default_plugins/TF
  Value: true
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 6.0
      Focal Shape Fixed Size: true
      Focal Shape Size: 0.05
      Focal Point:
        X: 1.5
        Y: 0.0
        Z: 0.5
      Name: Current View
      Near Clip Distance: 0.01
      Pitch: 0.45
      Target Frame: pelvis
      Value: Orbit (rviz)
      Yaw: 3.14
Window Geometry:
  Height: 900
  Width: 1400
  X: 100
  Y: 100
