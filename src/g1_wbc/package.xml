<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>g1_wbc</name>
  <version>0.1.0</version>
  <description>
    Sim-agnostic GR00T Whole-Body Control node for Unitree G1.
    Subscribes to /joint_states + /imu/data + /g1/cmd_vel,
    runs Balance/Walk ONNX policies, publishes /g1/joint_commands.
    Works with Gazebo, Isaac Sim, or a real robot that provides those topics.
  </description>
  <maintainer email="th.dhyan.us@gmail.com">thakk100</maintainer>
  <license>MIT</license>

  <depend>rclpy</depend>
  <depend>sensor_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>std_msgs</depend>
  <depend>trajectory_msgs</depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
