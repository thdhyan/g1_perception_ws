<?xml version="1.0" ?>
<sdf version="1.10">
  <world name="warehouse">
    <plugin
      filename="gz-sim-physics-system"
      name="gz::sim::systems::Physics">
      <engine type="ode">
        <max_step_size>0.001</max_step_size>
        <real_time_factor>1.0</real_time_factor>
      </engine>
    </plugin>

    <plugin
      filename="gz-sim-user-commands-system"
      name="gz::sim::systems::UserCommands"/>

    <plugin
      filename="gz-sim-scene-broadcaster-system"
      name="gz::sim::systems::SceneBroadcaster"/>

    <plugin
      filename="gz-sim-sensors-system"
      name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>

    <plugin
      filename="gz-sim-imu-system"
      name="gz::sim::systems::Imu"/>

    <plugin
      filename="gz-sim-contact-system"
      name="gz::sim::systems::Contact"/>

    <!-- Ground plane -->
    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 100</size>
            </plane>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 100</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.8 0.8 0.8 1</ambient>
            <diffuse>0.8 0.8 0.8 1</diffuse>
            <specular>0.8 0.8 0.8 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- Directional light -->
    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.8 0.8 0.8 1</specular>
      <direction>-0.5 0.5 -1</direction>
    </light>

    <!-- Scene ambient (SDF1.10: use <scene> block, not a light type="ambient") -->
    <scene>
      <ambient>0.4 0.4 0.4 1</ambient>
      <background>0.7 0.7 0.7 1</background>
    </scene>

    <!-- Warehouse walls (simple box perimeter) -->
    <model name="north_wall">
      <static>true</static>
      <pose>0 15 1.5 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>30 0.2 3</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>30 0.2 3</size></box></geometry>
          <material><ambient>0.6 0.6 0.5 1</ambient><diffuse>0.6 0.6 0.5 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="south_wall">
      <static>true</static>
      <pose>0 -15 1.5 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>30 0.2 3</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>30 0.2 3</size></box></geometry>
          <material><ambient>0.6 0.6 0.5 1</ambient><diffuse>0.6 0.6 0.5 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="east_wall">
      <static>true</static>
      <pose>15 0 1.5 0 0 1.5708</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>30 0.2 3</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>30 0.2 3</size></box></geometry>
          <material><ambient>0.6 0.6 0.5 1</ambient><diffuse>0.6 0.6 0.5 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="west_wall">
      <static>true</static>
      <pose>-15 0 1.5 0 0 1.5708</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>30 0.2 3</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>30 0.2 3</size></box></geometry>
          <material><ambient>0.6 0.6 0.5 1</ambient><diffuse>0.6 0.6 0.5 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Shelving unit 1 -->
    <model name="shelf_1">
      <static>true</static>
      <pose>5 5 1.0 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.4 3.0 2.0</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.4 3.0 2.0</size></box></geometry>
          <material><ambient>0.5 0.4 0.3 1</ambient><diffuse>0.5 0.4 0.3 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Shelving unit 2 -->
    <model name="shelf_2">
      <static>true</static>
      <pose>-5 5 1.0 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.4 3.0 2.0</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.4 3.0 2.0</size></box></geometry>
          <material><ambient>0.5 0.4 0.3 1</ambient><diffuse>0.5 0.4 0.3 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- ── Realistic Stationary Humanoid Models (Anatomical: Head, Torso, Limbs) ── -->

    <!-- Human 1: 4.0m Front Center (Blue Jacket, Dark Jeans) -->
    <model name="human_1">
      <static>true</static>
      <pose>4.0 0.0 0.0 0 0 3.14159</pose>
      <link name="link">
        <visual name="head">
          <pose>0 0 1.65 0 0 0</pose>
          <geometry><sphere><radius>0.12</radius></sphere></geometry>
          <material><ambient>0.9 0.75 0.65 1</ambient><diffuse>0.9 0.75 0.65 1</diffuse></material>
        </visual>
        <visual name="torso">
          <pose>0 0 1.20 0 0 0</pose>
          <geometry><cylinder><radius>0.18</radius><length>0.65</length></cylinder></geometry>
          <material><ambient>0.2 0.35 0.75 1</ambient><diffuse>0.2 0.35 0.75 1</diffuse></material>
        </visual>
        <visual name="left_leg">
          <pose>0 0.11 0.45 0 0 0</pose>
          <geometry><cylinder><radius>0.08</radius><length>0.85</length></cylinder></geometry>
          <material><ambient>0.15 0.15 0.22 1</ambient><diffuse>0.15 0.15 0.22 1</diffuse></material>
        </visual>
        <visual name="right_leg">
          <pose>0 -0.11 0.45 0 0 0</pose>
          <geometry><cylinder><radius>0.08</radius><length>0.85</length></cylinder></geometry>
          <material><ambient>0.15 0.15 0.22 1</ambient><diffuse>0.15 0.15 0.22 1</diffuse></material>
        </visual>
        <visual name="left_arm">
          <pose>0 0.26 1.15 0.15 0 0</pose>
          <geometry><cylinder><radius>0.06</radius><length>0.65</length></cylinder></geometry>
          <material><ambient>0.2 0.35 0.75 1</ambient><diffuse>0.2 0.35 0.75 1</diffuse></material>
        </visual>
        <visual name="right_arm">
          <pose>0 -0.26 1.15 -0.15 0 0</pose>
          <geometry><cylinder><radius>0.06</radius><length>0.65</length></cylinder></geometry>
          <material><ambient>0.2 0.35 0.75 1</ambient><diffuse>0.2 0.35 0.75 1</diffuse></material>
        </visual>
        <collision name="collision">
          <pose>0 0 0.9 0 0 0</pose>
          <geometry><capsule><radius>0.22</radius><length>1.4</length></capsule></geometry>
        </collision>
      </link>
    </model>

    <!-- Human 2: 3.0m Front-Left (Green Sweater, Khaki Pants) -->
    <model name="human_2">
      <static>true</static>
      <pose>3.0 3.0 0.0 0 0 -1.5708</pose>
      <link name="link">
        <visual name="head">
          <pose>0 0 1.65 0 0 0</pose>
          <geometry><sphere><radius>0.12</radius></sphere></geometry>
          <material><ambient>0.85 0.7 0.6 1</ambient><diffuse>0.85 0.7 0.6 1</diffuse></material>
        </visual>
        <visual name="torso">
          <pose>0 0 1.20 0 0 0</pose>
          <geometry><cylinder><radius>0.18</radius><length>0.65</length></cylinder></geometry>
          <material><ambient>0.2 0.65 0.35 1</ambient><diffuse>0.2 0.65 0.35 1</diffuse></material>
        </visual>
        <visual name="left_leg">
          <pose>0 0.11 0.45 0 0 0</pose>
          <geometry><cylinder><radius>0.08</radius><length>0.85</length></cylinder></geometry>
          <material><ambient>0.6 0.5 0.35 1</ambient><diffuse>0.6 0.5 0.35 1</diffuse></material>
        </visual>
        <visual name="right_leg">
          <pose>0 -0.11 0.45 0 0 0</pose>
          <geometry><cylinder><radius>0.08</radius><length>0.85</length></cylinder></geometry>
          <material><ambient>0.6 0.5 0.35 1</ambient><diffuse>0.6 0.5 0.35 1</diffuse></material>
        </visual>
        <visual name="left_arm">
          <pose>0 0.26 1.15 0.15 0 0</pose>
          <geometry><cylinder><radius>0.06</radius><length>0.65</length></cylinder></geometry>
          <material><ambient>0.2 0.65 0.35 1</ambient><diffuse>0.2 0.65 0.35 1</diffuse></material>
        </visual>
        <visual name="right_arm">
          <pose>0 -0.26 1.15 -0.15 0 0</pose>
          <geometry><cylinder><radius>0.06</radius><length>0.65</length></cylinder></geometry>
          <material><ambient>0.2 0.65 0.35 1</ambient><diffuse>0.2 0.65 0.35 1</diffuse></material>
        </visual>
        <collision name="collision">
          <pose>0 0 0.9 0 0 0</pose>
          <geometry><capsule><radius>0.22</radius><length>1.4</length></capsule></geometry>
        </collision>
      </link>
    </model>

    <!-- Human 3: 3.5m Front-Right (Orange High-Vis Jacket, Grey Pants) -->
    <model name="human_3">
      <static>true</static>
      <pose>3.5 -2.8 0.0 0 0 1.5708</pose>
      <link name="link">
        <visual name="head">
          <pose>0 0 1.65 0 0 0</pose>
          <geometry><sphere><radius>0.12</radius></sphere></geometry>
          <material><ambient>0.9 0.75 0.65 1</ambient><diffuse>0.9 0.75 0.65 1</diffuse></material>
        </visual>
        <visual name="torso">
          <pose>0 0 1.20 0 0 0</pose>
          <geometry><cylinder><radius>0.18</radius><length>0.65</length></cylinder></geometry>
          <material><ambient>0.95 0.5 0.1 1</ambient><diffuse>0.95 0.5 0.1 1</diffuse></material>
        </visual>
        <visual name="left_leg">
          <pose>0 0.11 0.45 0 0 0</pose>
          <geometry><cylinder><radius>0.08</radius><length>0.85</length></cylinder></geometry>
          <material><ambient>0.3 0.3 0.35 1</ambient><diffuse>0.3 0.3 0.35 1</diffuse></material>
        </visual>
        <visual name="right_leg">
          <pose>0 -0.11 0.45 0 0 0</pose>
          <geometry><cylinder><radius>0.08</radius><length>0.85</length></cylinder></geometry>
          <material><ambient>0.3 0.3 0.35 1</ambient><diffuse>0.3 0.3 0.35 1</diffuse></material>
        </visual>
        <visual name="left_arm">
          <pose>0 0.26 1.15 0.15 0 0</pose>
          <geometry><cylinder><radius>0.06</radius><length>0.65</length></cylinder></geometry>
          <material><ambient>0.95 0.5 0.1 1</ambient><diffuse>0.95 0.5 0.1 1</diffuse></material>
        </visual>
        <visual name="right_arm">
          <pose>0 -0.26 1.15 -0.15 0 0</pose>
          <geometry><cylinder><radius>0.06</radius><length>0.65</length></cylinder></geometry>
          <material><ambient>0.95 0.5 0.1 1</ambient><diffuse>0.95 0.5 0.1 1</diffuse></material>
        </visual>
        <collision name="collision">
          <pose>0 0 0.9 0 0 0</pose>
          <geometry><capsule><radius>0.22</radius><length>1.4</length></capsule></geometry>
        </collision>
      </link>
    </model>

    <!-- Human 4: 6.0m Mid-Range Front (Red Hoodie, Dark Pants) -->
    <model name="human_4">
      <static>true</static>
      <pose>6.0 1.5 0.0 0 0 3.14159</pose>
      <link name="link">
        <visual name="head">
          <pose>0 0 1.65 0 0 0</pose>
          <geometry><sphere><radius>0.12</radius></sphere></geometry>
          <material><ambient>0.9 0.75 0.65 1</ambient><diffuse>0.9 0.75 0.65 1</diffuse></material>
        </visual>
        <visual name="torso">
          <pose>0 0 1.20 0 0 0</pose>
          <geometry><cylinder><radius>0.18</radius><length>0.65</length></cylinder></geometry>
          <material><ambient>0.8 0.2 0.2 1</ambient><diffuse>0.8 0.2 0.2 1</diffuse></material>
        </visual>
        <visual name="left_leg">
          <pose>0 0.11 0.45 0 0 0</pose>
          <geometry><cylinder><radius>0.08</radius><length>0.85</length></cylinder></geometry>
          <material><ambient>0.15 0.15 0.2 1</ambient><diffuse>0.15 0.15 0.2 1</diffuse></material>
        </visual>
        <visual name="right_leg">
          <pose>0 -0.11 0.45 0 0 0</pose>
          <geometry><cylinder><radius>0.08</radius><length>0.85</length></cylinder></geometry>
          <material><ambient>0.15 0.15 0.2 1</ambient><diffuse>0.15 0.15 0.2 1</diffuse></material>
        </visual>
        <visual name="left_arm">
          <pose>0 0.26 1.15 0.15 0 0</pose>
          <geometry><cylinder><radius>0.06</radius><length>0.65</length></cylinder></geometry>
          <material><ambient>0.8 0.2 0.2 1</ambient><diffuse>0.8 0.2 0.2 1</diffuse></material>
        </visual>
        <visual name="right_arm">
          <pose>0 -0.26 1.15 -0.15 0 0</pose>
          <geometry><cylinder><radius>0.06</radius><length>0.65</length></cylinder></geometry>
          <material><ambient>0.8 0.2 0.2 1</ambient><diffuse>0.8 0.2 0.2 1</diffuse></material>
        </visual>
        <collision name="collision">
          <pose>0 0 0.9 0 0 0</pose>
          <geometry><capsule><radius>0.22</radius><length>1.4</length></capsule></geometry>
        </collision>
      </link>
    </model>

    <!-- Human 5: 3.5m Rear-Left (Purple Jacket, Black Pants) -->
    <model name="human_5">
      <static>true</static>
      <pose>-3.5 2.5 0.0 0 0 -0.7854</pose>
      <link name="link">
        <visual name="head">
          <pose>0 0 1.65 0 0 0</pose>
          <geometry><sphere><radius>0.12</radius></sphere></geometry>
          <material><ambient>0.85 0.7 0.6 1</ambient><diffuse>0.85 0.7 0.6 1</diffuse></material>
        </visual>
        <visual name="torso">
          <pose>0 0 1.20 0 0 0</pose>
          <geometry><cylinder><radius>0.18</radius><length>0.65</length></cylinder></geometry>
          <material><ambient>0.6 0.2 0.7 1</ambient><diffuse>0.6 0.2 0.7 1</diffuse></material>
        </visual>
        <visual name="left_leg">
          <pose>0 0.11 0.45 0 0 0</pose>
          <geometry><cylinder><radius>0.08</radius><length>0.85</length></cylinder></geometry>
          <material><ambient>0.12 0.12 0.15 1</ambient><diffuse>0.12 0.12 0.15 1</diffuse></material>
        </visual>
        <visual name="right_leg">
          <pose>0 -0.11 0.45 0 0 0</pose>
          <geometry><cylinder><radius>0.08</radius><length>0.85</length></cylinder></geometry>
          <material><ambient>0.12 0.12 0.15 1</ambient><diffuse>0.12 0.12 0.15 1</diffuse></material>
        </visual>
        <visual name="left_arm">
          <pose>0 0.26 1.15 0.15 0 0</pose>
          <geometry><cylinder><radius>0.06</radius><length>0.65</length></cylinder></geometry>
          <material><ambient>0.6 0.2 0.7 1</ambient><diffuse>0.6 0.2 0.7 1</diffuse></material>
        </visual>
        <visual name="right_arm">
          <pose>0 -0.26 1.15 -0.15 0 0</pose>
          <geometry><cylinder><radius>0.06</radius><length>0.65</length></cylinder></geometry>
          <material><ambient>0.6 0.2 0.7 1</ambient><diffuse>0.6 0.2 0.7 1</diffuse></material>
        </visual>
        <collision name="collision">
          <pose>0 0 0.9 0 0 0</pose>
          <geometry><capsule><radius>0.22</radius><length>1.4</length></capsule></geometry>
        </collision>
      </link>
    </model>

    <!--
      Moving pedestrian actor (Gazebo Harmonic actor system, see
      https://gazebosim.org/docs/harmonic/actors/). Unlike human_1..human_5
      above (static primitive-geometry models), this one actually walks, so
      detection nodes (livox_detection VoxelNeXt/PointPillar/CenterPoint) have
      a moving target to track instead of only static boxes. Path: X=-3,
      Y oscillating -4 <-> 4 (8m, clear of shelf_1/shelf_2 at Y=5 and
      human_1..3 at X=3..4), ~1.2 m/s walking pace, loops forever.
    -->
    <actor name="human_walking">
      <skin>
        <filename>https://fuel.gazebosim.org/1.0/Mingfei/models/actor/tip/files/meshes/walk.dae</filename>
        <scale>1.0</scale>
      </skin>
      <animation name="walk">
        <filename>https://fuel.gazebosim.org/1.0/Mingfei/models/actor/tip/files/meshes/walk.dae</filename>
        <interpolate_x>true</interpolate_x>
      </animation>
      <script>
        <loop>true</loop>
        <delay_start>0.0</delay_start>
        <auto_start>true</auto_start>
        <trajectory id="0" type="walk" tension="0.6">
          <waypoint>
            <time>0</time>
            <pose>-3 -4 1.0 0 0 1.5708</pose>
          </waypoint>
          <waypoint>
            <time>6.67</time>
            <pose>-3 4 1.0 0 0 1.5708</pose>
          </waypoint>
          <waypoint>
            <time>7.17</time>
            <pose>-3 4 1.0 0 0 -1.5708</pose>
          </waypoint>
          <waypoint>
            <time>13.84</time>
            <pose>-3 -4 1.0 0 0 -1.5708</pose>
          </waypoint>
          <waypoint>
            <time>14.34</time>
            <pose>-3 -4 1.0 0 0 1.5708</pose>
          </waypoint>
        </trajectory>
      </script>
    </actor>

  </world>
</sdf>
