Panels:
  - Class: rviz_common/Displays
    Name: Displays
  - Class: rviz_common/Views
    Name: Views
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Enabled: true
    - Class: rviz_default_plugins/Path
      Name: cuVSLAM Path
      Topic:
        Value: /visual_slam/tracking/slam_path
      Enabled: true
      Color: 25; 255; 0
    - Class: rviz_default_plugins/Odometry
      Name: cuVSLAM Odometry
      Topic:
        Value: /visual_slam/tracking/odometry
      Enabled: true
    - Class: nvblox_rviz_plugin/NvbloxMesh
      Name: nvblox Mesh
      Topic:
        Value: /nvblox_node/mesh
      Enabled: true
  Global Options:
    Fixed Frame: vslam_map
    Background Color: 48; 48; 48
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 10
      Focal Point:
        X: 0
        Y: 0
        Z: 0
      Pitch: 0.5
      Yaw: 0.8
Window Geometry:
  Height: 900
  Width: 1400
