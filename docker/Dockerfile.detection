# Dockerfile.detection — VoxelNeXt detection node
#
# GPU base: nvidia/cuda:12.1.1-cudnn8-devel-ubuntu24.04
# Installs ROS Jazzy from official apt repo, torch cu121, spconv-cu121,
# and compiles VoxelNeXt/pcdet CUDA ops from source (CUDA_HOME available).
#
# x86_64 (laptop, CUDA 12.1):
#   docker build -f docker/Dockerfile.detection -t g1_detection:jazzy .
#
# ARM64 Jetson Orin (JetPack 6, CUDA 12.2):
#   docker build \
#     --build-arg CUDA_BASE=dustynv/ros:humble-ros-base-l4t-r36.2.0 \
#     --build-arg TORCH_URL=https://developer.download.nvidia.com/compute/redist/jp/v60/pytorch/torch-2.3.0a0+6ddf5cf85e.nv24.04-cp310-cp310-linux_aarch64.whl \
#     --build-arg SPCONV_PKG=spconv-cu122 \
#     -f docker/Dockerfile.detection -t g1_detection:orin .
#
# Run:
#   docker run --rm --network host --gpus all \
#     -v /path/to/voxelnext_nuscenes.pth:/checkpoints/voxelnext_nuscenes.pth:ro \
#     -e ROS_DOMAIN_ID=42 \
#     thdhyan/g1-detection:latest

# ── x86 default: CUDA 12.1 devel on Ubuntu 24.04 ───────────────────────────
ARG CUDA_BASE=nvidia/cuda:12.6.3-cudnn-devel-ubuntu24.04
FROM ${CUDA_BASE}

ARG TORCH_URL=https://download.pytorch.org/whl/cu124/torch-2.5.1%2Bcu124-cp312-cp312-linux_x86_64.whl
ARG SPCONV_PKG=spconv-cu124

ENV DEBIAN_FRONTEND=noninteractive \
    CUDA_HOME=/usr/local/cuda \
    PATH=/usr/local/cuda/bin:$PATH \
    LD_LIBRARY_PATH=/usr/local/cuda/lib64:$LD_LIBRARY_PATH

# ── System packages + ROS Jazzy ─────────────────────────────────────────────
RUN apt-get update && apt-get install -y --no-install-recommends \
        curl gnupg lsb-release ca-certificates \
        python3-pip python3-dev \
        git build-essential cmake \
        && rm -rf /var/lib/apt/lists/*

# ROS Jazzy (Ubuntu 24.04 / noble)
RUN curl -sSL https://raw.githubusercontent.com/ros/rosdistro/master/ros.asc \
        | gpg --dearmor -o /usr/share/keyrings/ros-archive-keyring.gpg && \
    echo "deb [arch=$(dpkg --print-architecture) signed-by=/usr/share/keyrings/ros-archive-keyring.gpg] \
        http://packages.ros.org/ros2/ubuntu $(. /etc/os-release && echo $UBUNTU_CODENAME) main" \
        > /etc/apt/sources.list.d/ros2.list && \
    apt-get update && apt-get install -y --no-install-recommends \
        ros-jazzy-ros-base \
        ros-jazzy-vision-msgs \
        python3-colcon-common-extensions \
        python3-rosdep \
    && rm -rf /var/lib/apt/lists/*

# ── Python: torch + spconv + pcdet deps ─────────────────────────────────────
RUN pip3 install --no-cache-dir --break-system-packages "${TORCH_URL}"
RUN pip3 install --no-cache-dir --break-system-packages "${SPCONV_PKG}"
RUN pip3 install --no-cache-dir --break-system-packages \
    numpy llvmlite numba easydict pyyaml scikit-image tqdm SharedArray

# ── VoxelNeXt / pcdet ───────────────────────────────────────────────────────
WORKDIR /ws
COPY VoxelNeXt/ VoxelNeXt/

# Compile pcdet CUDA extensions (CUDA_HOME set above)
RUN cd VoxelNeXt && python3 setup.py develop

# ── ROS livox_detection package ─────────────────────────────────────────────
COPY src/livox_detection/ src/livox_detection/

RUN . /opt/ros/jazzy/setup.sh && \
    colcon build --symlink-install --packages-select livox_detection && \
    rm -rf build/

ENV ROS_DOMAIN_ID=42
COPY entrypoint_ros.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh
ENTRYPOINT ["/entrypoint.sh"]

CMD ["ros2", "run", "livox_detection", "livox_detection_node", \
     "--ros-args", \
     "-p", "algorithm:=voxelnext", \
     "-p", "checkpoint_path:=/checkpoints/voxelnext_nuscenes.pth", \
     "-p", "input_topic:=/livox/lidar", \
     "-p", "score_threshold:=0.25", \
     "-p", "max_range:=4.0", \
     "-p", "class_filter:=pedestrian"]
