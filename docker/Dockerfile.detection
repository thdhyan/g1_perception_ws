# Dockerfile.detection — VoxelNeXt detection node
#
# Builds on x86_64 (laptop) or ARM64 (Jetson) — same Dockerfile, different base.
#
# x86_64 (laptop, CUDA 12.1):
#   docker build -f docker/Dockerfile.detection -t g1_detection:jazzy .
#
# ARM64 Jetson Orin (JetPack 6, CUDA 12.2):
#   docker build --build-arg BASE=dustynv/ros:humble-ros-base-l4t-r36.2.0 \
#                --build-arg TORCH_URL=https://developer.download.nvidia.com/compute/redist/jp/v60/pytorch/torch-2.3.0a0+6ddf5cf85e.nv24.04-cp310-cp310-linux_aarch64.whl \
#                --build-arg SPCONV_BRANCH=v2.3.6 \
#                -f docker/Dockerfile.detection -t g1_detection:orin .
#
# ARM64 Jetson Xavier/Orin (JetPack 5, CUDA 11.4):
#   docker build --build-arg BASE=dustynv/ros:humble-ros-base-l4t-r35.4.1 \
#                --build-arg TORCH_URL=https://developer.download.nvidia.com/compute/redist/jp/v51/pytorch/torch-2.0.0+nv23.05-cp38-cp38-linux_aarch64.whl \
#                --build-arg SPCONV_BRANCH=v2.3.6 \
#                -f docker/Dockerfile.detection -t g1_detection:xavier .
#
# Run (any platform):
#   docker run --rm --network host --gpus all \
#     -v /path/to/voxelnext_nuscenes.pth:/checkpoints/voxelnext_nuscenes.pth:ro \
#     -e ROS_DOMAIN_ID=42 \
#     g1_detection:jazzy

ARG BASE=osrf/ros:jazzy-desktop
FROM ${BASE}

# Torch wheel URL — override for Jetson
ARG TORCH_URL=https://download.pytorch.org/whl/cu121/torch-2.3.1%2Bcu121-cp312-cp312-linux_x86_64.whl
# spconv tag — v2.3.6 builds on both x86 and Jetson CUDA variants
ARG SPCONV_BRANCH=v2.3.6

ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends \
    python3-pip python3-dev git build-essential cmake \
    libboost-all-dev libpcl-dev \
    ros-${ROS_DISTRO}-vision-msgs \
    && rm -rf /var/lib/apt/lists/*

# Torch + torchvision (x86: cu121 wheel; Jetson: override TORCH_URL)
RUN pip3 install --no-cache-dir --break-system-packages "${TORCH_URL}"

# spconv — build from source (works on x86 and ARM64 Jetson)
RUN git clone --depth 1 --branch ${SPCONV_BRANCH} \
    https://github.com/traveller59/spconv.git /opt/spconv && \
    cd /opt/spconv && \
    SPCONV_DISABLE_JIT=1 pip3 install --no-cache-dir --break-system-packages -e .

# Workspace copy (only the detection package + VoxelNeXt)
WORKDIR /ws
COPY src/livox_detection/ src/livox_detection/
COPY VoxelNeXt/ VoxelNeXt/
COPY patches/voxelnext/ patches/voxelnext/

# Apply VoxelNeXt patches
RUN cd VoxelNeXt && \
    git apply ../patches/voxelnext/centernet_utils_topk_sparse_fix.patch && \
    git apply ../patches/voxelnext/datasets_argo2_optional.patch && \
    python3 setup.py develop

# Build ROS package
RUN . /opt/ros/${ROS_DISTRO}/setup.sh && \
    colcon build --symlink-install --packages-select livox_detection && \
    rm -rf build/

ENV ROS_DOMAIN_ID=42
COPY entrypoint_ros.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh
ENTRYPOINT ["/entrypoint.sh"]

CMD ["ros2", "run", "livox_detection", "livox_detection_node", \
     "--ros-args", \
     "-p", "algorithm:=voxelnext", \
     "-p", "checkpoint_path:=/checkpoints/voxelnext_nuscenes.pth", \
     "-p", "input_topic:=/livox/lidar", \
     "-p", "score_threshold:=0.25", \
     "-p", "max_range:=4.0", \
     "-p", "class_filter:=pedestrian"]
