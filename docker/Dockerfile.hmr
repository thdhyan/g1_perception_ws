# Dockerfile.hmr — LiDAR-HMR (humanm3) + smpl_hmr_node + reid_server_node
#
# GPU base: nvidia/cuda:12.1.1-cudnn8-devel-ubuntu24.04
# Installs ROS Jazzy, torch cu121, PyG, and LiDAR-HMR deps.
# Checkpoints are NOT baked in — mount at runtime:
#   -v /path/to/LiDAR-HMR/ckpts:/ws/LiDAR-HMR/ckpts:ro
#   -v /path/to/smpl/SMPL_NEUTRAL.pkl:/ws/LiDAR-HMR/body_models/smpl/SMPL_NEUTRAL.pkl:ro
#
# x86_64 (laptop, CUDA 12.1):
#   docker build -f docker/Dockerfile.hmr -t thdhyan/g1-hmr:latest .
#
# ARM64 Jetson Orin (JetPack 6):
#   docker build \
#     --build-arg CUDA_BASE=dustynv/ros:humble-ros-base-l4t-r36.2.0 \
#     --build-arg TORCH_URL=https://developer.download.nvidia.com/compute/redist/jp/v60/pytorch/torch-2.3.0a0+6ddf5cf85e.nv24.04-cp310-cp310-linux_aarch64.whl \
#     --build-arg BUILD_PYG=1 \
#     -f docker/Dockerfile.hmr -t thdhyan/g1-hmr:orin .
#
# Run:
#   docker run --rm --network host --gpus all \
#     -v /Storage/models/LiDAR-HMR/ckpts:/ws/LiDAR-HMR/ckpts:ro \
#     -e ROS_DOMAIN_ID=42 \
#     thdhyan/g1-hmr:latest

ARG CUDA_BASE=nvidia/cuda:12.6.3-cudnn-devel-ubuntu24.04
FROM ${CUDA_BASE}

ARG TORCH_URL=https://download.pytorch.org/whl/cu124/torch-2.5.1%2Bcu124-cp312-cp312-linux_x86_64.whl
ARG TORCHVISION_URL=https://download.pytorch.org/whl/cu124/torchvision-0.20.1%2Bcu124-cp312-cp312-linux_x86_64.whl
# Set to 1 on Jetson to build torch-scatter from source (no prebuilt ARM64 wheels)
ARG BUILD_PYG=0

ENV DEBIAN_FRONTEND=noninteractive \
    CUDA_HOME=/usr/local/cuda \
    PATH=/usr/local/cuda/bin:$PATH \
    LD_LIBRARY_PATH=/usr/local/cuda/lib64:$LD_LIBRARY_PATH \
    TORCH_CUDA_ARCH_LIST="7.0;7.5;8.0;8.6;8.7;8.9;9.0+PTX"

# ── System packages + ROS Jazzy ─────────────────────────────────────────────
RUN apt-get update && apt-get install -y --no-install-recommends \
        curl gnupg lsb-release ca-certificates \
        python3-pip python3-dev git build-essential cmake \
    && rm -rf /var/lib/apt/lists/*

# ROS Jazzy (Ubuntu 24.04 / noble)
RUN curl -sSL https://raw.githubusercontent.com/ros/rosdistro/master/ros.asc \
        | gpg --dearmor -o /usr/share/keyrings/ros-archive-keyring.gpg && \
    echo "deb [arch=$(dpkg --print-architecture) signed-by=/usr/share/keyrings/ros-archive-keyring.gpg] \
        http://packages.ros.org/ros2/ubuntu $(. /etc/os-release && echo $UBUNTU_CODENAME) main" \
        > /etc/apt/sources.list.d/ros2.list && \
    apt-get update && apt-get install -y --no-install-recommends \
        ros-jazzy-ros-base \
        ros-jazzy-vision-msgs \
        ros-jazzy-tf2-ros \
        ros-jazzy-tf2-sensor-msgs \
        python3-colcon-common-extensions \
        python3-rosdep \
    && rm -rf /var/lib/apt/lists/*

# ── Torch + torchvision ──────────────────────────────────────────────────────
RUN pip3 install --no-cache-dir --break-system-packages "${TORCH_URL}" "${TORCHVISION_URL}"

# ── PyG: prebuilt x86 wheels; from-source on Jetson ─────────────────────────
RUN if [ "$BUILD_PYG" = "1" ]; then \
        pip3 install --no-cache-dir --break-system-packages torch-scatter torch-geometric; \
    else \
        pip3 install --no-cache-dir --break-system-packages \
            --find-links https://data.pyg.org/whl/torch-2.5.0+cu124.html \
            torch-scatter torch-geometric; \
    fi

# ── HMR Python deps ──────────────────────────────────────────────────────────
# Purge apt numpy (RECORD-less deb install blocks pip upgrade) then reinstall
RUN apt-get remove -y python3-numpy 2>/dev/null || true
RUN pip3 install --no-cache-dir --break-system-packages \
    numpy smplx>=0.1.28 chumpy>=0.70 transforms3d>=0.4.1 \
    einops>=0.7.0 timm>=0.9.0 scikit-learn>=1.3.0 \
    yacs>=0.1.8 easydict pyyaml

# ── LiDAR-HMR source (no checkpoints — mount at runtime) ────────────────────
WORKDIR /ws
COPY LiDAR-HMR/ LiDAR-HMR/

# ── g1_perception ROS package ────────────────────────────────────────────────
COPY src/g1_perception/ src/g1_perception/

RUN . /opt/ros/jazzy/setup.sh && \
    colcon build --symlink-install --packages-select g1_perception && \
    rm -rf build/

ENV ROS_DOMAIN_ID=42
COPY entrypoint_ros.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh
ENTRYPOINT ["/entrypoint.sh"]

CMD ["ros2", "run", "g1_perception", "smpl_hmr_node", \
     "--ros-args", \
     "-p", "checkpoint:=humanm3", \
     "-p", "device:=cuda", \
     "-p", "min_score:=0.25", \
     "-p", "max_range:=4.0"]
